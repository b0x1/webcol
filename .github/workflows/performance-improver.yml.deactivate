name: Performance Improver Agent

on:
  schedule:
    - cron: '0 4 * * 6'
  workflow_dispatch:

jobs:
  optimize:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@v6
      - uses: ./.github/actions/jules-invoke
        with:
          prompt_file: ./.github/prompts/performance-improver.md
          jules_api_key: ${{ secrets.JULES_API_KEY }}
